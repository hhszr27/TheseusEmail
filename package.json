{
  "name": "mailforge",
  "version": "0.1.0",
  "description": "可插件化安全桌面邮件客户端",
  "private": true,
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run i18n:check && npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "oneclick": "node scripts/oneclick.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "verify:backup": "npm run build:scripts && cross-env ELECTRON_RUN_AS_NODE=1 electron out/scripts/verify-backup.js"
  },
  "dependencies": {
    "@sentry/electron": "^8.3.0",
    "@tanstack/react-virtual": "^3.14.21",
    "@tiptap/extension-character-count": "^3.32.0",
    "@tiptap/extension-color": "^3.32.0",
    "@tiptap/extension-font-family": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@vitejs/plugin-react": "^6.1.2",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.8",
    "electron": "^44.9.2",
    "electron-vite": "6.0.0",
    "imapflow": "^2.5.9",
    "jsdom": "^30.1.3",
    "mailparser": "^3.10.0",
    "nodemailer": "^10.1.7",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^8.12.3",
    "vite": "^8.3.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
