# ===== MailForge 账户配置（Phase 1） =====
# 复制本文件为 .env 并填入真实值。.env 不要提交到版本库。

# --- IMAP 收信 ---
IMAP_HOST=imap.qq.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=your-account@qq.com
# QQ / 163 等使用"客户端授权码"，不是登录密码
IMAP_PASS=your-authorization-code

# --- SMTP 发信（发送能力在后续 Phase 接入） ---
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true

# ===== 可选 =====
# 崩溃上报（留空则完全关闭，默认不上报）
# SENTRY_DSN=

# 企业代理（也可使用系统代理；私网地址始终直连）
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,.internal

# 单次同步拉取的邮件数量上限（默认 200）
# IMAP_SYNC_LIMIT=200

# ===== Phase 3：第三方服务 =====
# VirusTotal（附件/URL 哈希查询；留空则完全关闭扫描）
# VIRUSTOTAL_API_KEY=

# 说明：翻译与 AI 的密钥在应用内"设置 → 翻译 / AI 助手"中填写，存入系统密钥库。
